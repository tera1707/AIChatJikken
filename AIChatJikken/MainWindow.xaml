<Window x:Class="AIChatJikken.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AIChatJikken"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        Title="MainWindow" Height="650" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="キャラクター1："/>
            <TextBox Name="Character1Name" Text="おじいちゃん" Width="200"/>
            <TextBlock Text="キャラクター2：" Margin="10,0"/>
            <TextBox Name="Character2Name" Text="ギャル" Width="200"/>
            <TextBlock Text="会話の回数：" Margin="10,0"/>
            <TextBox Name="MaxConversationCount" Text="2" Width="50" />
        </StackPanel>
        
        <StackPanel Grid.Row="1" Margin="0,10">
            <TextBlock Text="初回の話題"/>
            <TextBox x:Name="PromptBox" Height="100" TextWrapping="Wrap" AcceptsReturn="True"/>
            <Button x:Name="SendButton" Content="送信" Click="Button_Click"  Margin="0,10,0,0"/>
        </StackPanel>
        
        <Grid Grid.Row="2" >
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ResponseBlock1" Grid.Column="0" TextWrapping="Wrap" Margin="0,0,0,0" />
            </ScrollViewer>
        </Grid>
    </Grid>

</Window>
