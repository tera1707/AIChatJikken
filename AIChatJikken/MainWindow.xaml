<Window x:Class="AIChatJikken.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AIChatJikken"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        Title="MainWindow" Height="650" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBox x:Name="PromptBox" Height="100" TextWrapping="Wrap" AcceptsReturn="True"/>
            <Button x:Name="SendButton" Content="送信" Click="Button_Click"  Margin="0,10,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <!--<ColumnDefinition />-->
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ResponseBlock1" Grid.Column="0" TextWrapping="Wrap" Margin="0,0,0,0"/>
            <TextBlock x:Name="ResponseBlock2" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,0" Visibility="Collapsed"/>
        </Grid>
    </Grid>

</Window>
